{concat(str(health_pct); 
    ", "; 
    str(mod(health_pct; 9.5));
    ", ";
    str(ceil(sub(100.0; health_pct)))
)}

{with_font(st(concat(
    repeat(from_codepoint(7307); int(div(health_pct; 10)));
    if(geq(health_pct; 99); ""; from_codepoint(add(7304; mul(div(int(mod(health_pct; 10)); 10); 4))));
    repeat(from_codepoint(7304); int(div(sub(100.0; health_pct); 10)))
)); "tpack:default")}

