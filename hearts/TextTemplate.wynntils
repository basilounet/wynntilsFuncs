  repeat(concat(from_codepoint(7304); from_codepoint(6990)); 
    if(gte(health_pct; 50); 0; int(div(sub(50.0; health_pct); 5))));
  if(lte(value(status_effect_modifier("Extra Health")); 0); ""; concat(
