{with_font(st(concat(
    repeat(concat(from_codepoint(7307); from_codepoint(6990));
        if(gte(health_pct; 50); 10; int(div(health_pct; 5))));
    if(geq(health_pct; 50); ""; concat(
        from_codepoint(add(7304; mul(div(mod(health_pct; 5); 5); 4))); 
        from_codepoint(6990)));
    repeat(concat(from_codepoint(7304); from_codepoint(6990)); 
        if(gte(health_pct; 50); 0; int(div(sub(50.0; health_pct); 5))));
    "\n\n\n\n\n";
    repeat(concat(from_codepoint(7307); from_codepoint(6990)); 
        if(lt(health_pct; 50); 0; int(min(int(div(sub(health_pct; 50); 5)); 10))));
    if(or(lt(health_pct; 50); gte(health_pct; 100)); ""; concat(
        from_codepoint(add(7304; mul(div(mod(health_pct; 5); 5); 4)));
        from_codepoint(6990)));
    repeat(concat(from_codepoint(7304); from_codepoint(6990)); 
        if(lte(health_pct; 50); 10; int(div(sub(100.0; health_pct); 5))));
    "\n\n\n\n\n";
    repeat(concat(from_codepoint(7311); from_codepoint(6990)); 
        int(div(sub(health_pct; 100); 10)));
    if(lte(health_pct; 100); ""; concat(
        from_codepoint(add(7308; mul(div(mod(health_pct; 5); 5); 4)));
        from_codepoint(6990);
        "\n\n\n\n"));
    repeat(concat(from_codepoint(7303); "\n\n\n"); int(div(mana_pct; 10)));
    if(geq(mana_pct; 100); ""; concat(from_codepoint(add(7300; mul(div(int(mod(mana_pct; 10)); 10); 4))); "\n\n\n"));
    repeat(concat(from_codepoint(7300); "\n\n\n"); int(div(sub(100.0; mana_pct); 10)))
)); "tpack:default")}